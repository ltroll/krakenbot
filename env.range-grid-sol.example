# Copy to env.range-grid-sol and add a dedicated Kraken API key.
# This starts in paper mode because the selected strategy is paper-only.

RANGE_GRID_INSTANCE_ID=sol
SIGNAL_ASSET_ID=SOL
KRAKEN_PAIR=SOLUSD
RANGE_GRID_ASSET_BALANCE_KEYS=SOL

KRAKEN_API_URL=https://api.kraken.com
KRAKEN_TICKER_URL=
KRAKEN_ORDERBOOK_URL=
KRAKEN_OHLC_URL=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

LLM_SIGNAL_URL=http://screenpi.local/bot/multi_asset_signal.json
PRICE_LOG_URL=
RANGE_GRID_PRICE_LOG_FIELD=asset_price_usd

RANGE_GRID_STRATEGY_PROFILE=range_grid_strategy_sol_paper_baseline.json
RANGE_GRID_STRATEGY_DIRECTORY=/home/ben/krakenbot
RANGE_GRID_ANCHOR_ROUTER_ENABLED=false

# Hard instance allocation. The bot can use at most this much SOL inventory
# and leaves at least the configured reserve in the shared USD balance.
RANGE_GRID_CAPITAL_ALLOCATION_USD=500
RANGE_GRID_QUOTE_CASH_RESERVE_USD=100

# Paper mode does not need the live gate. To promote a separately reviewed
# live SOL profile later, both values must be set exactly as shown.
RANGE_GRID_LIVE_ENABLED=false
RANGE_GRID_LIVE_CONFIRMATION=

RANGE_GRID_ORDER_TRACKER_URL=http://screenpi.local/cgi-bin/order-ledger
RANGE_GRID_ORDER_TRACKER_USER_AGENT=range-grid-sol/1.0
RANGE_GRID_ORDER_TRACKER_SYMBOL=SOLUSD
ORDER_OWNER_TAG_SOURCE=range-grid-sol

RANGE_GRID_CONTROL_HOST=0.0.0.0
RANGE_GRID_CONTROL_PORT=8788
RANGE_GRID_CONTROL_TOKEN=replace-with-a-unique-long-token
RANGE_GRID_CONTROL_BACKTEST_URL=http://screenpi.local/bot/sol/range_grid_backtest.json
RANGE_GRID_CONTROL_BACKTEST_CACHE_SECONDS=300

RANGE_GRID_BACKTEST_SNAPSHOT_FILE=/var/www/html/bot/sol/range_grid_backtest_snapshot_log.jsonl
RANGE_GRID_BACKTEST_OUTPUT_FILE=/var/www/html/bot/sol/range_grid_backtest.json
RANGE_GRID_BACKTEST_ARCHIVE_DIR=/var/www/html/bot/sol/range_grid_backtest
RANGE_GRID_BACKTEST_STRATEGY_SET_FILE=sol_range_grid_strategy_test_set.txt
RANGE_GRID_BACKTEST_STRATEGY_COMPARE_CSV_FILE=/var/www/html/bot/sol/range_grid_backtest_strategy_compare.csv
RANGE_GRID_BACKTEST_STRATEGY_RANKED_CSV_FILE=/var/www/html/bot/sol/range_grid_backtest_strategy_ranked.csv
RANGE_GRID_BACKTEST_ANCHOR_WINNERS_FILE=/var/www/html/bot/sol/range_grid_anchor_winners.json
RANGE_GRID_ACTIVITY_LOG_ROTATE_DAILY=false

